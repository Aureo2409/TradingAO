rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ----------------------------------------------------
    // FUNÇÕES AUXILIARES DE CONTROLE DE ACESSO
    // ----------------------------------------------------
    
    // Verifica se o utilizador está autenticado no Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Verifica se o documento pertence ao próprio utilizador logado
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Obtém o documento do utilizador logado na coleção 'users'
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Verifica se o utilizador logado tem a permissão de administrador
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin';
    }

    // ----------------------------------------------------
    // REGRAS POR COLEÇÃO
    // ----------------------------------------------------

    // Coleção: users (perfil sob o ID do UID do Auth)
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Coleção: usernames (controle de unicidade)
    match /usernames/{username} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Coleção: courses (cursos criados por admins)
    match /courses/{courseId} {
      allow read: if true; 
      allow write: if isAdmin();
    }

    // Coleção: lessons (aulas associadas aos cursos)
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coleção: quizzes (questionários)
    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coleção: questions (perguntas dos quizzes)
    match /questions/{questionId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Coleção: userProgress (progresso individual de estudos)
    match /userProgress/{progressId} {
      allow read: if isAuthenticated() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow write: if isAuthenticated() && (request.resource.data.uid == request.auth.uid || isAdmin());
    }

    // Coleção: scores (ranking e histórico de tentativas de quiz)
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
